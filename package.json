{
  "name": "bpce-compass",
  "version": "0.1.0",
  "private": true,
  "description": "BPCE Compass — prototype hackathon : assistant bancaire conversationnel intégré (données 100 % fictives).",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint",
