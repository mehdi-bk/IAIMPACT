# Copy to .env.local and fill in. Never commit real keys.

# --- Text assistant (at least ONE provider) ---------------------------------
# Claude (default when set). Model defaults to claude-opus-5-5 at low effort.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=low                    # low | medium | high
# ANTHROPIC_CLASSIFIER_MODEL=claude-haiku-4-5
# ANTHROPIC_SERVER_FALLBACK=true          # server-side refusal fallback (beta)

# OpenAI — required for VOICE (Realtime), optional fallback for text.
OPENAI_API_KEY=
# LLM_PROVIDER=anthropic                  # force anthropic | openai for text
# OPENAI_TEXT_MODEL=gpt-6.1-sol
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# OPENAI_REALTIME_REASONING=low           # optional, gpt-realtime-2.x only

# --- Demo control panel ------------------------------------------------------
# Enabled by default in `next dev`, disabled in production unless true.
# DEMO_MODE=true
# DEMO_ALLOW_LAN=false                    # true = allow from other devices on the LAN

# --- Storage -----------------------------------------------------------------
# COMPASS_DB_PATH=data/compass.db
