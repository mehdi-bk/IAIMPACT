LLM_PROVIDER=deepseek
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
# Copy to .env.local and fill in. Never commit real keys.

# DEEPSEEK_CLASSIFIER_MODEL=deepseek-flash


# OpenAI — required for VOICE (Realtime), optional alternative for text.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# OPENAI_REALTIME_REASONING=low           # optional, gpt-realtime-2.x only

# --- Demo control panel ------------------------------------------------------
# Enabled by default in `next dev`, disabled in production unless true.
# DEMO_MODE=true
# DEMO_ALLOW_LAN=false                    # true = allow from other devices on the LAN

# --- Storage -----------------------------------------------------------------
# COMPASS_DB_PATH=data/compass.db
